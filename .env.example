# Copy to .env for local Docker Compose use. Never commit the copied file.
MONGO_HOST_PORT=27017
MONGO_ROOT_USERNAME=replace-me
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_DATABASE=BulletinBoardDb
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
POST_STORAGE=inmemory
VITE_API_BASE_URL=/api
# Optional hosted-environment controls.
CORS_ALLOWED_ORIGINS=http://localhost:8081
RESET_API_KEY=
REDIS_CONNECTION_STRING=
